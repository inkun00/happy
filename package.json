{
  "name": "happy-routine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --prefix server",
    "check:pages": "node scripts/check-page-lines.mjs",
    "test": "vitest run",
    "test:all": "npm test && npm test --prefix server",
    "test:e2e": "playwright test",
    "ci:local": "npm run test:all && npm run build && npm run test:e2e && node --check server/index.js && node --check server/rateLimit.js && node --check server/backup-db.mjs",
    "test:watch": "vitest",
    "prebuild": "npm run check:pages",
    "build": "tsc -b && vite build",
    "build:mobile": "npm run check:pages && tsc -b && vite build --base ./",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:sync:all": "npm run build:mobile && npx cap sync android && npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:ios": "npx cap open ios",
    "preview": "vite preview",
    "preview:with-api": "concurrently -n site,api -c green,magenta \"npm run preview\" \"npm run dev:api\"",
    "compose:up": "node scripts/compose-up.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tensorflow-models/face-landmarks-detection": "^1.0.5",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  }
}
