# API 포트
# PORT=8787

# 응답 본문 gzip: `compression` 미들웨어(추가 환경 변수 없음)

# 로드밸런서·Compose 헬스: GET /api/health → {"ok":true,"db":true} (SQLite SELECT 1 실패 시 503)
# 배포 확인: GET /api/version → package name·version (디바이스 헤더 불필요)

# 역프록시 뒤일 때: Express가 X-Forwarded-For 등으로 req.ip 복원 (값: 1 | true | 홉 수 숫자)
# compose.yaml 기본은 1. 로컬 단독 실행은 비워도 됨.
# TRUST_PROXY=1

# SQLite 파일 경로(미설정 시 서버 폴더의 happy.sqlite). Docker에서는 /data/happy.sqlite 권장
# 연결 시 PRAGMA: WAL·busy_timeout·foreign_keys=ON (db.js)
# SQLITE_PATH=

# 콤마로 구분한 브라우저 출처 화이트리스트 (비우면 개발 편의상 모든 Origin 허용)
# 프로덕션에서는 실제 프론트 URL을 넣는 것을 권장합니다.
# ALLOWED_ORIGINS=https://your-app.pages.dev,http://localhost:5173

# true일 때만 POST /api/events 를 SQLite에 기록(클라이언트 VITE_TELEMETRY=true 권장)
# TELEMETRY_ENABLED=true

# GET /api/admin/telemetry/summary · /api/admin/kpis — 헤더 X-Admin-Key 와 일치(12자 이상)
# ADMIN_API_KEY=
