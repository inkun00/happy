# 프로덕션 빌드 후 API가 다른 도메인이면 반드시 설정 (예: https://api.example.com)
# 비우면 dev에서는 Vite 프록시(/api), preview에서도 프록시 사용 가능
# Docker Compose 데모(web:8080 nginx → /api 프록시)도 VITE_API_URL 비움(상대 경로 /api) 권장
# VITE_API_URL=https://api.example.com
#
# Vercel: 대시보드 Environment Variables에 Production/Preview용으로 설정 (빌드 시 주입).
# API는 Vercel 정적 호스트에 포함되지 않음 — 루트 render.yaml 로 Render에 server(Docker) 배포 후 Public URL 지정.
#
# 연동 순서(요약)
# 1) Render에서 Web Service 생성(Docker · server/Dockerfile) → Public URL 복사
# 2) Vercel 프로젝트에 VITE_API_URL=https://(위 URL, 경로 없음)
# 3) Render 환경 변수 ALLOWED_ORIGINS=https://(Vercel 도메인)
# 4) Vercel Redeploy
#
# 로컬만: VITE_API_URL 비움 + npm run dev (웹+API) 또는 npm run dev:api (API만)

# true일 때만 /api/events 로 익명 이벤트 전송(서버에서 TELEMETRY_ENABLED=true 필요)
# VITE_TELEMETRY=true

# Capacitor/실기기에서는 로컬호스트 프록시가 없으므로 API 전체 URL(HTTPS) 권장
# VITE_API_URL=https://your-api.example.com

# 홈 화면은 마운트 시 GET /api/health 를 호출합니다(상대 /api 또는 위 URL).
# 모바일 동기화: npm run cap:sync(기본) · npm run cap:sync:all(android+ios)
